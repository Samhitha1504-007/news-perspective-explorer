# Copy to .env.local and fill in. Never commit .env.local.
# Server-only settings (no NEXT_PUBLIC_ prefix, so they never reach the browser)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=npe_app
MYSQL_PASSWORD=app_pass123
MYSQL_DATABASE=news_perspective_db

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=news_perspective_db

JWT_SECRET=change_me_to_a_long_random_string
