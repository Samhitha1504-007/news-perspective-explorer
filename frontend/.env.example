# Copy to .env.local and fill in. Never commit .env.local.
# Server-only settings (no NEXT_PUBLIC_ prefix, so they never reach the browser)
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Two MySQL accounts, one per role (database/mysql/06_db_roles.sql).
# Admins' requests use npe_admin, readers' requests use npe_reader.
MYSQL_ADMIN_USER=npe_admin
MYSQL_ADMIN_PASSWORD=admin_pass123
MYSQL_READER_USER=npe_reader
MYSQL_READER_PASSWORD=reader_pass123
MYSQL_DATABASE=news_perspective_db

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=news_perspective_db

JWT_SECRET=change_me_to_a_long_random_string
