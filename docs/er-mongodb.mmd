erDiagram
    users ||..o{ search_logs : "user_id"
    users ||..o{ reading_history : "user_id"
    users ||..o{ comparison_sessions : "user_id"
    articles ||..o| article_content : "article_id"
    articles ||..o| article_metadata : "article_id"
    articles ||..o| perspective_analysis : "article_id"
    articles ||..o{ reading_history : "article_id"
    topics ||..o{ comparison_sessions : "topic_id"

    users {
        int user_id PK "MySQL"
    }
    articles {
        int article_id PK "MySQL"
    }
    topics {
        int topic_id PK "MySQL"
    }
    article_content {
        objectId _id PK "MongoDB"
        int article_id
        string content
        string source_url
    }
    article_metadata {
        objectId _id PK "MongoDB"
        int article_id
        array keywords
        array entities
        int word_count
        array tags
    }
    search_logs {
        objectId _id PK "MongoDB"
        int user_id
        string query
        int result_count
        date timestamp
    }
    perspective_analysis {
        objectId _id PK "MongoDB"
        int article_id
        string label
        array matched_terms
        object term_weights
        object raw_scores
        date analyzed_at
    }
    reading_history {
        objectId _id PK "MongoDB"
        int user_id
        int article_id
        string event_type
        date timestamp
    }
    comparison_sessions {
        objectId _id PK "MongoDB"
        int user_id
        int topic_id
        array compared_sources
        date timestamp
    }
